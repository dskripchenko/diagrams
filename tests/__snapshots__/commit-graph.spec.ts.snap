// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`commit graph SVG > rows line up with the host list; merges are rings; head is marked 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" id="g1" class="dg dg-commit-graph" width="32" height="120" viewBox="0 0 32 120" role="img" aria-labelledby="g1-title"><title id="g1-title">Commit graph</title><style>#g1{font-family:var(--dg-font-family, ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif);font-size:14px;color:var(--dg-text, #1f2937)}#g1 text{fill:var(--dg-text, #1f2937)}#g1 .dg-label{fill:var(--dg-node-text, #1e1b4b)}#g1 .dg-node .dg-shape{fill:var(--dg-node-fill, #eef2ff);stroke:var(--dg-node-stroke, #6366f1);stroke-width:1.5px}#g1 .dg-cluster-box{fill:var(--dg-cluster-fill, #f8fafc);stroke:var(--dg-cluster-stroke, #cbd5e1);stroke-width:1px}#g1 .dg-cluster-label{fill:var(--dg-cluster-text, #334155);font-weight:600}#g1 .dg-cluster-title .dg-cluster-label{stroke:var(--dg-cluster-fill, #f8fafc);stroke-width:4px;stroke-linejoin:round;paint-order:stroke}#g1 .dg-edge{fill:none;stroke:var(--dg-line, #64748b);stroke-width:1.5px}#g1 .dg-edge-thick{stroke-width:3.5px}#g1 .dg-edge-dotted{stroke-dasharray:3 3}#g1 .dg-marker{fill:var(--dg-line, #64748b);stroke:var(--dg-line, #64748b)}#g1 .dg-edge-label-box{fill:var(--dg-edge-label-fill, #ffffff);opacity:0.9}#g1 .dg-edge-label{fill:var(--dg-text, #1f2937)}#g1 .dg-muted{fill:var(--dg-text-muted, #6b7280)}#g1 a{cursor:pointer}#g1 .dg-commit-line{fill:none;stroke-width:2px;stroke-linecap:round}#g1 .dg-commit-dot{stroke:var(--dg-row-fill, #ffffff);stroke-width:1.5px}#g1 .dg-commit-merge{fill:var(--dg-row-fill, #ffffff);stroke-width:2px}#g1 .dg-commit-head{fill:none;stroke-width:1.5px}</style><g class="dg-commit-lines"><path class="dg-commit-line" d="M8,15 L8,30" style="stroke:var(--dg-pie-1, #6366f1)"/><path class="dg-commit-line" d="M8,15 C8,21 24,19.5 24,30" style="stroke:var(--dg-pie-2, #f59e0b)"/><path class="dg-commit-line" d="M24,30 L24,45" style="stroke:var(--dg-pie-2, #f59e0b)"/><path class="dg-commit-line" d="M8,30 L8,60" style="stroke:var(--dg-pie-1, #6366f1)"/><path class="dg-commit-line" d="M24,45 L24,60" style="stroke:var(--dg-pie-2, #f59e0b)"/><path class="dg-commit-line" d="M8,60 L8,75" style="stroke:var(--dg-pie-1, #6366f1)"/><path class="dg-commit-line" d="M24,60 L24,90" style="stroke:var(--dg-pie-2, #f59e0b)"/><path class="dg-commit-line" d="M8,75 L8,90" style="stroke:var(--dg-pie-1, #6366f1)"/><path class="dg-commit-line" d="M8,90 L8,105" style="stroke:var(--dg-pie-1, #6366f1)"/><path class="dg-commit-line" d="M24,90 C24,100.5 8,99 8,105" style="stroke:var(--dg-pie-2, #f59e0b)"/></g><g class="dg-commit-dots"><circle class="dg-commit-head" cx="8" cy="15" r="7" style="stroke:var(--dg-pie-1, #6366f1)"/><circle class="dg-commit-dot dg-commit-merge" cx="8" cy="15" r="4" data-id="m" style="stroke:var(--dg-pie-1, #6366f1)"/><circle class="dg-commit-dot" cx="24" cy="45" r="4" data-id="f" style="fill:var(--dg-pie-2, #f59e0b)"/><circle class="dg-commit-dot" cx="8" cy="75" r="4" data-id="b" style="fill:var(--dg-pie-1, #6366f1)"/><circle class="dg-commit-dot" cx="8" cy="105" r="4" data-id="a" style="fill:var(--dg-pie-1, #6366f1)"/></g></svg>"`;
