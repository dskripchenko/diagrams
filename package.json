{
  "name": "@dskripchenko/diagrams",
  "version": "1.2.0",
  "description": "Diagrams from text — Mermaid and PlantUML syntaxes — rendered to SVG with zero runtime dependencies: flowchart, sequence, state, ER, class, C4, pie, gantt, timeline, XY chart, mind map, user journey, quadrant, kanban, requirement, architecture, sankey, git graph, block, use case, component, deployment, activity",
  "keywords": [
    "diagram",
    "mermaid",
    "plantuml",
    "sankey",
    "gitgraph",
    "kanban",
    "uml-diagrams",
    "activity-diagram",
    "component-diagram",
    "flowchart",
    "sequence-diagram",
    "state-diagram",
    "er-diagram",
    "class-diagram",
    "uml",
    "gantt",
    "c4",
    "c4-model",
    "pie-chart",
    "svg",
    "graph-layout",
    "sugiyama",
    "markdown",
    "zero-dependency",
    "ssr"
  ],
  "homepage": "https://github.com/dskripchenko/diagrams#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dskripchenko/diagrams.git"
  },
  "bugs": {
    "url": "https://github.com/dskripchenko/diagrams/issues"
  },
  "license": "MIT",
  "author": "Denis Skripchenko (https://github.com/dskripchenko)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "check:browser": "node scripts/browser-check.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.59.4",
    "eslint": "^10.13.0",
    "jsdom": "^29.1.1",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  }
}
